{
  "name": "bb-plugin-antigravity-plus",
  "version": "0.4.1",
  "type": "module",
  "license": "MIT",
  "author": "Tim Sherstyuk",
  "description": "Use Antigravity CLI in BB with built-in 5h/7d quotas, thread forking, /compact, per-model reasoning, and a live /swarm board.",
  "homepage": "https://github.com/tymshe/bb-plugin-antigravity-plus#readme",
  "bugs": {
    "url": "https://github.com/tymshe/bb-plugin-antigravity-plus/issues"
  },
  "keywords": [
    "bb-plugin",
    "antigravity",
    "agy",
    "gemini",
    "quota",
    "usage",
    "reasoning",
    "swarm",
    "compact",
    "fork",
    "acp"
  ],
  "files": [
    "server.ts",
    "host.ts",
    "app.tsx",
    "cli.ts",
    "auto-compaction.ts",
    "profile-bindings.ts",
    "background-tasks.ts",
    "subagents.ts",
    "dialect.ts",
    "prompt-mode.ts",
    "mode-controls.ts",
    "usage.ts",
    "maintenance.ts",
    "swarm-contract.ts",
    "swarm-board.ts",
    "acp-proxy.ts",
    "agy-fork.ts",
    "dist/*.js",
    "dist/*.css",
    "dist/*.meta.json",
    "!dist/*.map",
    "README.md",
    "LICENSE",
    "PLUGIN_OVERVIEW.md",
    "SECURITY.md",
    "docs",
    "assets",
    "skills"
  ],
  "engines": {
    "bb": ">=0.50",
    "bbPluginSdk": ">=0.6.150 <0.7",
    "node": ">=22"
  },
  "bb": {
    "name": "Antigravity Provider +",
    "description": "Use Antigravity CLI in BB with built-in 5h/7d quotas, thread forking, /compact, per-model reasoning, and a live /swarm board. Uses your existing agy login with no extra API keys. Requires agy 1.5.0+ (1.5.14+ for /compact). Verified on macOS, Linux, and Windows.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "host": "./host.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "bbMarketplace": {
    "category": "agents-and-providers",
    "secondaryCategories": [
      "token-usage-and-limits"
    ],
    "screenshots": [
      "./assets/screenshots/thread-workflow.png",
      "./assets/screenshots/usage.png",
      "./assets/screenshots/swarm-board.png",
      "./assets/screenshots/settings.png"
    ]
  },
  "scripts": {
    "build": "bb plugin build",
    "check": "tsc --noEmit",
    "check:release": "node --experimental-strip-types scripts/check-release.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "smoke": "node --experimental-strip-types scripts/smoke.mjs"
  },
  "dependencies": {
    "@get-bb/plugin-sdk": "0.6.157",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tymshe/bb-plugin-antigravity-plus.git"
  }
}
